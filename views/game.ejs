<!DOCTYPE html>
<html>
  <head>
    <title>Play GeoGenius!</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
     integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
     crossorigin=""/>
  </head>
  <body>
    <nav>
      <div class="logo">🌍 GeoQuiz</div>
      <div class="nav-links">
        <a href="/">Exit</a>
      </div>
    </nav>
    <div id="quiz-container">
      <div id="map"></div>
      <div id="question-container">
        <h1 id="question"> Question Not Found </h1>
        <p id="timer">Time Left: 30 Seconds</p>
        <p id="score">Score: 0</p>
      </div>
    </div>
    
    <div id="end-game-modal" class="modal-overlay" style="display: none;">
      <div class="modal-content">
        <h1>Game Over!</h1>
        <p>Final Score</p>
        <h2 id="final-score-display">0</h2>
        <div class="modal-buttons">
          <button onclick="location.reload()" class="auth-button">Play Again</button>
          <a href="/" class="auth-button" style="text-decoration: none; display: inline-block; width: auto; background: white;">Home</a>
        </div>
      </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
       integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
       crossorigin=""></script>
    <script>var currentUser = "<%= user ? user.username : '' %>";</script>
    <script src="/game.js"></script>
  </body>
</html>
