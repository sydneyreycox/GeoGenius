<!DOCTYPE html>
<html>
<head>
  <title>GeoGenius</title>
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
     integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
     crossorigin=""/>
</head>
<body>
  <nav>
    <div class="logo">🌍 GeoGenius</div>
    <div class="nav-links">
      <% if (user) { %>
        <% if (user.is_admin) { %>
          <a href="/admin" class="admin-button">ADMIN PANEL</a>
        <% } %>
        
        <span>Welcome, <strong><%= user.username %></strong></span>
        <a href="/users/logout">Logout</a>
      <% } else { %>
        <a href="/users/login">Login</a>
        <a href="/users/register">Register</a>
      <% } %>
    </div>
  </nav>
  <div class="home-container">
      <div class="left-panel">
        <div class="buttons">
          <select id="tag-select">
            <% tags.forEach(tag => { %>
              <option value="<%= tag.tagId %>" <%= tag.tagId === 1 ? 'selected' : '' %>><%= tag.tagName %></option>
            <% }) %>
          </select>
          <button class="play-button">Test your knowledge</button>
        
        </div>
        <div id="map"></div>
      </div>
      <div class="right-panel">
        <div class="leaderboard">
          <table>
            <thead>
              <tr>
                <th>Rank</th>
                <th>Name</th>
                <th>Score</th>
              </tr>
            </thead>
            <tbody>
               <% players.forEach((player, index) => { %> 
                <tr>
                    <td><%= index + 1 %></td> 
                    <td><%= player.username %></td>
                    <td><%= player.score %></td>
                </tr>
            <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
</body>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
       integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
       crossorigin=""></script>
  <script src="/leaderboard.js"></script>
  <script src="/home.js"></script>
</html>
